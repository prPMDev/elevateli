{
  "manifest_version": 3,
  "name": "ElevateLI",
  "version": "1.0.0",
  "description": "Optimize your LinkedIn profile with AI-powered suggestions",
  "default_locale": "en",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "src/content/modules/constants.js",
        "src/content/modules/state.js",
        "src/content/modules/chromeUtils.js",
        "src/content/modules/memoryManager.js",
        "src/content/modules/domUtils.js",
        "src/content/modules/ownership-detector.js",
        "src/content/modules/core/cache-manager.js",
        "src/content/modules/extractors/base-extractor.js",
        "src/content/modules/extractors/photo.js",
        "src/content/modules/extractors/headline.js",
        "src/content/modules/extractors/about.js",
        "src/content/modules/extractors/experience.js",
        "src/content/modules/extractors/skills.js",
        "src/content/modules/extractors/education.js",
        "src/content/modules/extractors/recommendations.js",
        "src/content/modules/extractors/certifications.js",
        "src/content/modules/extractors/projects.js",
        "src/content/modules/extractors/featured.js",
        "src/content/modules/scoring/completeness-scorer.js",
        "src/content/modules/analysis/first-impression-analyzer.js",
        "src/content/modules/ui/overlay-manager.js",
        "src/content/modules/analyzer-base.js",
        "src/content/modules/analyzer-main.js"
      ],
      "css": [
        "src/content/overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "src/images/icon16.png",
      "48": "src/images/icon48.png",
      "128": "src/images/icon128.png"
    },
    "default_title": "ElevateLI - LinkedIn Optimizer"
  },
  "icons": {
    "16": "src/images/icon16.png",
    "48": "src/images/icon48.png",
    "128": "src/images/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/images/icon.png",
        "src/images/icon48.png",
        "updates.html",
        "privacy-terms.html"
      ],
      "matches": [
        "https://www.linkedin.com/*",
        "chrome-extension://*/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  }
}
